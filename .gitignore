## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
.vs/
Generated\ Files/

# Test / coverage output
[Tt]est[Rr]esult*/
TestResult.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# .NET / NuGet
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Publish / environment secrets
publish/
*.pubxml
*.publishproj
PublishScripts/
.env
.env.*
!.env.example

# Local databases / logs / generated data
*.db
*.db-shm
*.db-wal
*.log

# Parking Pejam commercial secrets and customer licenses
license.json
*.license.json
*.pem
!docs/keys/README.md
deploy/secrets/
secrets/

# Customer deployment state
.deploy/

# Node / Python caches
node_modules/
__pycache__/
*.pyc

# IDE / tooling
.localhistory/
.ionide/
_ReSharper*/
*.DotSettings.user
*.userprefs
*.cache
